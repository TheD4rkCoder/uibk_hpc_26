/.quarto/
**/*.quarto_ipynb

# original source material (kept locally, not in the repo)
*.pdf
*.pptx
*.xlsx

# Quarto's generated support files (reveal.js, MathJax, clipboard.js, ...).
# _libs/ is the single shared copy configured via `lib-dir` in _quarto.yml;
# <deck>_files/ is the per-deck tree Quarto used before that. Both are
# regenerated by `quarto render` and should never be committed.
#/_libs/
*_files/

# transient LaTeX aux files from tools/build_figs.py
.build/

# byte-compiled shared/figs/figtheme.py
__pycache__/

# Rendered from index.qmd, which exists only so `quarto preview` works on the
# whole project. The published site gets its own root redirect from
# .github/workflows/pages.yml.
/index.html
